{
    "build": {
        "builder": "DOCKERFILE"
    },
    "deploy": {
        "startCommand": "python3 bot.py",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    },
    "variables": {
        "HEADLESS": "true",
        "ADBLOCK_ENABLED": "true",
        "BROWSER_PROFILE_PATH": "./brave-data",
        "NODE_ENV": "production",
        "DEFAULT_VOLUME": "0.5"
    },
    "volumes": {
        "/app/brave-data": {}
    }
}
